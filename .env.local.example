# Bu faylı .env.local adı ilə kopyalayıb orada doldurun. Bu fayla həqiqi açar YAZMAYIN (git-ə düşür).

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# YALNIZ scripts/seed.ts üçün (bir dəfəlik, sonra silin). NEXT_PUBLIC_ prefiksi ilə yazmayın!
SUPABASE_SERVICE_ROLE_KEY=

# AI təqdimat (Gemini). Açarı yalnız burada saxlayın, heç vaxt NEXT_PUBLIC_ ilə yazmayın
GEMINI_API_KEY=
# İstəyə görə model adı (şəkil yarada bilən model olmalıdır)
GEMINI_MODEL=gemini-3.1-flash-image

# OpenAI şəkil (varsa Gemini əvəzinə bu istifadə olunur)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
